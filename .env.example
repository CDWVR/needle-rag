# Needle configuration. Copy to .env and fill in the keys. Everything else is optional;
# the values shown are the defaults.

# ---------------------------------------------------------------------------
# OpenRouter: the answer writer, the grounding checker, and query rewrites
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# CHECKER_MODEL=deepseek/deepseek-v4-flash
# WRITER_ATTEMPTS=2

# ---------------------------------------------------------------------------
# Voice input (Whisper on OpenRouter)
# ---------------------------------------------------------------------------
# The Voice button records up to STT_MAX_SECONDS and sends the clip for transcription. Use a
# SEPARATE key with its own credit limit (OpenRouter dashboard, Keys) so speech can never spend
# more than that limit. OpenRouter refuses audio requests (HTTP 402) unless the key's limit leaves at
# least $0.50 available, so set the limit to $1 or more; STT_DAILY_USD is what actually caps spending.
# If unset, the main OPENROUTER_API_KEY is used. With no key the button hides.
# OPENROUTER_STT_API_KEY=your_speech_only_key_here
# STT_MODEL=openai/whisper-large-v3-turbo
# STT_MAX_SECONDS=15
# STT_DAILY_USD=0.01
# STT_RESERVE_PER_SECOND=0.0001

# ---------------------------------------------------------------------------
# Jev reranker
# ---------------------------------------------------------------------------
# Jev decides which retrieved passages are real evidence. It is called through OpenRouter
# (https://openrouter.ai/api/v1/systemone) with OPENROUTER_API_KEY. Without a key, search falls
# back to a local cross-encoder (if sentence-transformers is installed) or to fused ranking, and
# answers are marked low confidence.
# JEV_MODEL=typesafe/jev-1.13
# JEV_ENDPOINT=https://openrouter.ai/api/v1/systemone
# JEV_RELEVANCE_THRESHOLD=0.20     # passages scoring below this are dropped
# JEV_MAX_CONCURRENCY=4            # parallel scoring requests, shared by all users
# JEV_TIMEOUT_SECONDS=30           # per request; then the fallback ranker takes over
# JEV_MAX_RETRIES=2
# JEV_CACHE_TTL_SECONDS=3600       # in-memory score cache
# JEV_CANDIDATE_LIMIT=15           # Jev scores the top fused candidates only; 0 = all
# RETRIEVAL_RERANK_MODE=jev_filter # jev_filter | jev_soft | fused_only
# CIRCUIT_FAILURES=3               # Jev / writer failures before the breaker opens
# CIRCUIT_RESET_SECONDS=60

# ---------------------------------------------------------------------------
# Access and network (see SECURITY.md)
# ---------------------------------------------------------------------------
# NEEDLE_ACCESS_TOKEN=             # sign-in token, 16+ chars; unset = generated into backend/secrets/
# NEEDLE_SESSION_SECRET=           # signs session cookies; unset = generated; change it to log everyone out
# NEEDLE_SESSION_HOURS=12
# NEEDLE_HOST=127.0.0.1            # `python main.py` binds loopback; 0.0.0.0 to serve a network
# NEEDLE_PORT=8000
# NEEDLE_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]   # Host headers the server answers
# NEEDLE_COOKIE_SECURE=false       # true behind HTTPS
# NEEDLE_CORS_ORIGINS=             # only if another origin hosts the UI
# NEEDLE_ENABLE_API_DOCS=false     # /api/docs (still behind sign-in)
# NEEDLE_AUTH_DISABLED=false       # local development only; never on a network
# NEEDLE_MAX_UPLOAD_MB=50
# NEEDLE_MAX_PDF_PAGES=2000
# NEEDLE_MAX_UNZIPPED_MB=300       # Office files are zips; caps what they may expand to

# ---------------------------------------------------------------------------
# Retrieval defaults (workspace settings override these per question)
# ---------------------------------------------------------------------------
# NEEDLE_TOP_K=30
# NEEDLE_SIMILARITY_THRESHOLD=0.30
# NEEDLE_RRF_K=60
# RETRY_THRESHOLD=0.35             # a weaker best Jev score triggers one rewritten search
# RETRY_TOP_K=40
# RELATED_LIMIT=3                  # passages shown as "related" when an answer is withheld
# Token budgets include hidden reasoning tokens (DeepSeek V4.1 reasons before answering).
# OPENROUTER_REASONING_EFFORT=low  # empty = do not send a reasoning hint
# CONDENSE_MAX_TOKENS=800
# WRITER_MAX_TOKENS=4000
# CHECKER_MAX_TOKENS=2500
# CONDENSE_HISTORY_TURNS=8
# CONFIDENCE_HIGH=0.60
# CONFIDENCE_MEDIUM=0.35
# MIN_QUOTE_CHARS=12
# MIN_SUPPORTED_CHARS=40

# ---------------------------------------------------------------------------
# Embeddings and storage
# ---------------------------------------------------------------------------
# Embedding backend: minilm (default, local), openrouter, or tei (see docker-compose.tei.yml).
# Changing it makes the active index incompatible until you run Refresh index.
# EMBED_BACKEND=minilm
# TEI_URL=http://127.0.0.1:18080
# NEEDLE_DATA_DIR=                 # where indexes, uploads, and workspace.db live (default: backend/)
# OCR_ENABLED=false                # needs pytesseract + pdf2image
# CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------------------------------------------------------------------------
# Index refresh gate and evaluation
# ---------------------------------------------------------------------------
# EVAL_MIN_GOLDEN=30               # golden questions covering your documents before refresh can publish
# EVAL_RECALL_DROP=0.10            # largest recall@k drop a refresh may cause
# EVAL_K=5
# REFRESH_GATE_USE_JEV=false       # true = gate on the full Jev ranking (costs credit)
# EVAL_MAX_COST_USD=1.00           # `python -m eval run` stops starting questions past this spend
# EVAL_JUDGE_MODEL=                # model for `--judge`; defaults to CHECKER_MODEL
# COST_JEV_PER_CANDIDATE=0.00002   # used for spend estimates only
