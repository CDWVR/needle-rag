# OpenRouter API key (https://openrouter.ai/keys)
# Used for Jev reranking and for the cited answer model.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional overrides
# JEV_MODEL=typesafe/jev-1.13
# OPENROUTER_MODEL=google/gemini-2.5-flash
# JEV_RELEVANCE_THRESHOLD=0.20
# JEV_MAX_CONCURRENCY=4
# JEV_CACHE_TTL_SECONDS=3600
# NEEDLE_TOP_K=30
# NEEDLE_SIMILARITY_THRESHOLD=0.30
# NEEDLE_RRF_K=60
# CONDENSE_MAX_TOKENS=120
# CONDENSE_HISTORY_TURNS=8
# RETRY_THRESHOLD=0.35
# RETRY_TOP_K=40
# RELATED_LIMIT=3
# CIRCUIT_FAILURES=3
# CIRCUIT_RESET_SECONDS=60
# WRITER_ATTEMPTS=2
# CONFIDENCE_HIGH=0.60
# CONFIDENCE_MEDIUM=0.35
# CHECKER_MODEL=google/gemini-2.5-flash
# CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
