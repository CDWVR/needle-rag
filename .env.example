# NEEDLE_TOP_K=30
# NEEDLE_SIMILARITY_THRESHOLD=0.30
# NEEDLE_RRF_K=60
# CONDENSE_MAX_TOKENS=120
# CONDENSE_HISTORY_TURNS=8
